# Normalize line endings: store LF in the repo, checkout native (CRLF on Windows)
* text=auto

# Always LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf

# Binary — never touch line endings
*.png binary
*.jpg binary
*.pdf binary
*.parquet binary
*.xlsx binary
*.pyc binary
*.pyd binary
*.db binary
